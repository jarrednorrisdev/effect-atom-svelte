{
  "name": "effect-atom-svelte",
  "version": "0.0.0",
  "description": "Svelte 5 bindings for Effect Atom",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*"],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "esm-env": "^1.2.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@demo/domain": "workspace:*",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "effect": "4.0.0",
    "playwright": "^1.57.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  }
}
