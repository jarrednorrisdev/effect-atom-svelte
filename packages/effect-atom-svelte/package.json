{
  "name": "effect-atom-svelte",
  "version": "0.0.0",
  "description": "Svelte 5 bindings for Effect Atom",
  "keywords": [
    "effect",
    "effect-atom",
    "reactivity",
    "state",
    "svelte",
    "sveltekit"
  ],
  "homepage": "https://atom.jarrednorris.dev",
  "bugs": "https://github.com/jarrednorrisdev/effect-atom-svelte/issues",
  "license": "MIT",
  "author": "Jarred Norris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarrednorrisdev/effect-atom-svelte.git",
    "directory": "packages/effect-atom-svelte"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sveltekit": {
      "types": "./dist/SvelteKit.d.ts",
      "default": "./dist/SvelteKit.js"
    }
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json && bun scripts/check-docs.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "esm-env": "^1.2.2"
  },
  "devDependencies": {
    "@demo/domain": "workspace:*",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "effect": "4.0.0",
    "playwright": "^1.57.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "svelte": "^5.57.0"
  }
}
